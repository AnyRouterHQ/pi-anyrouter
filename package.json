{
  "name": "@anyr/pi",
  "version": "0.1.2",
  "type": "module",
  "main": "./index.mjs",
  "description": "Official AnyRouter provider extension for the pi coding agent",
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "anyrouter",
    "openai-compatible"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AnyRouterHQ/pi-anyrouter.git"
  },
  "homepage": "https://anyrouter.dev",
  "bugs": {
    "url": "https://github.com/AnyRouterHQ/pi-anyrouter/issues"
  },
  "files": [
    "LICENSE",
    "README.md",
    "index.mjs",
    "mcp-config.mjs",
    "src"
  ],
  "pi": {
    "extensions": [
      "./index.mjs",
      "./mcp-config.mjs"
    ]
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "prepublishOnly": "npm test",
    "publish:local": "npm publish --access public"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  }
}
